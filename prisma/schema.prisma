// suppIT.me — schemat bazy danych
// Etap 1 używa modelu User; pozostałe modele są przygotowane pod kolejne etapy.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Użytkownicy i role ─────────────

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum Locale {
  pl
  de
  en
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CLIENT)
  locale       Locale   @default(pl)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Konto klienta powiązane z kartoteką klienta (role = CLIENT)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String? @unique

  assignedOrders Order[]             @relation("OrderAssignee")
  statusChanges  OrderStatusChange[]
  events         CalendarEvent[]
}

// ───────────── Klienci ─────────────

model Client {
  id             String   @id @default(cuid())
  name           String
  companyName    String?
  email          String?
  phone          String?
  whatsapp       String? // numer w formacie E.164, np. +48123456789
  notifyEmail    Boolean  @default(true)
  notifyWhatsapp Boolean  @default(false)
  locale         Locale   @default(pl)
  street         String?
  postalCode     String?
  city           String?
  country        String?  @default("PL")
  taxId          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User?
  orders    Order[]
  equipment InventoryItem[]

  @@index([name])
  @@index([phone])
}

// ───────────── Zlecenia ─────────────

enum OrderType {
  SERVICE // serwis / naprawa
  PURCHASE // zamówienie sprzętu
  WEBSITE // strona WWW
}

enum OrderStatus {
  NEW
  DIAGNOSIS
  AWAITING_APPROVAL
  AWAITING_PARTS
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  ADMIN // dodane ręcznie
  PUBLIC_FORM // formularz zgłoszenia naprawy
  CLIENT_PANEL
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Order {
  id            String      @id @default(cuid())
  number        Int         @unique @default(autoincrement())
  type          OrderType   @default(SERVICE)
  status        OrderStatus @default(NEW)
  source        OrderSource @default(ADMIN)
  priority      Priority    @default(NORMAL)
  title         String
  description   String?
  // Urządzenie (dla zleceń serwisowych)
  deviceType    String?
  deviceBrand   String?
  deviceModel   String?
  serialNumber  String?
  accessories   String?
  // Koszty
  estimatedCost Decimal?    @db.Decimal(10, 2)
  finalCost     Decimal?    @db.Decimal(10, 2)
  promoCode     String?
  // Terminy
  scheduledAt   DateTime?
  dueAt         DateTime?
  completedAt   DateTime?
  archived      Boolean     @default(false)
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  client     Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId   String
  assignee   User?   @relation("OrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId String?

  statusHistory OrderStatusChange[]
  events        CalendarEvent[]
  items         InventoryItem[]
  partOrders    PartOrder[]
  notifications NotificationLog[]

  @@index([status, archived])
  @@index([clientId])
  @@index([type])
}

model OrderStatusChange {
  id              String       @id @default(cuid())
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  note            String?
  visibleToClient Boolean      @default(true)
  createdAt       DateTime     @default(now())

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  changedBy   User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedById String?

  @@index([orderId, createdAt])
}

// ───────────── Kalendarz ─────────────

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime?
  allDay      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId  String?

  @@index([start])
}

// ───────────── Magazyn ─────────────

enum Ownership {
  COMPANY // stan firmy
  CLIENT // sprzęt klienta
}

model InventoryItem {
  id            String    @id @default(cuid())
  name          String
  sku           String?
  category      String?
  ownership     Ownership @default(COMPANY)
  quantity      Int       @default(1)
  minQuantity   Int       @default(0)
  location      String?
  serialNumber  String?
  purchasePrice Decimal?  @db.Decimal(10, 2)
  salePrice     Decimal?  @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId  String?

  @@index([ownership])
  @@index([sku])
}

// ───────────── Zamówienia części ─────────────

enum PartOrderStatus {
  REQUESTED
  ORDERED
  SHIPPED
  RECEIVED
  CANCELLED
}

model PartOrder {
  id             String          @id @default(cuid())
  partName       String
  supplier       String?
  supplierUrl    String?
  quantity       Int             @default(1)
  unitPrice      Decimal?        @db.Decimal(10, 2)
  status         PartOrderStatus @default(REQUESTED)
  trackingNumber String?
  orderedAt      DateTime?
  expectedAt     DateTime?
  receivedAt     DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  @@index([status])
}

// ───────────── Treści publiczne ─────────────

enum DiscountType {
  PERCENT
  FIXED
}

model Promotion {
  id           String       @id @default(cuid())
  code         String?      @unique
  discountType DiscountType @default(PERCENT)
  value        Decimal      @db.Decimal(10, 2)
  validFrom    DateTime?
  validTo      DateTime?
  active       Boolean      @default(true)
  maxUses      Int?
  usedCount    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  translations PromotionTranslation[]
}

model PromotionTranslation {
  id          String  @id @default(cuid())
  locale      Locale
  title       String
  description String?

  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String

  @@unique([promotionId, locale])
}

model Article {
  id          String    @id @default(cuid())
  category    String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  translations ArticleTranslation[]
}

model ArticleTranslation {
  id      String  @id @default(cuid())
  locale  Locale
  slug    String
  title   String
  excerpt String?
  content String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId String

  @@unique([articleId, locale])
  @@unique([locale, slug])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  url       String?
  logoUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ───────────── Ustawienia i powiadomienia ─────────────

// Ustawienia klucz → wartość (logo, adres, telefon, dostawca WhatsApp itd.)
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  status    OrderStatus
  channel   NotificationChannel
  locale    Locale
  subject   String? // tylko e-mail
  body      String // zmienne: {{clientName}}, {{orderNumber}}, {{status}}, {{note}}
  active    Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([status, channel, locale])
}

enum NotificationState {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  recipient String
  state     NotificationState   @default(PENDING)
  error     String?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?
}
