# Baza danych
DATABASE_URL="postgresql://suppit:suppit@localhost:5432/suppit?schema=public"

# Auth.js — wygeneruj: npx auth secret  (lub: openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Konto administratora tworzone przez seed
SEED_ADMIN_EMAIL="kontakt@suppit.me"
SEED_ADMIN_PASSWORD="ZmienMnie123!"

# Katalog na wgrane pliki (logo, obrazki) — w Dockerze wolumen /app/uploads
UPLOAD_DIR="./uploads"

# Domena dla Caddy (produkcja)
DOMAIN="suppit.me"
POSTGRES_PASSWORD="change-me"

# Publiczny adres aplikacji (linki w powiadomieniach)
APP_URL="http://localhost:3000"
# Strefa czasowa serwera (daty w formularzach i powiadomieniach)
TZ="Europe/Berlin"

# ── Powiadomienia e-mail (docelowo edytowalne w Ustawieniach) ──
# EMAIL_PROVIDER: smtp | resend (puste = wykryj automatycznie)
EMAIL_PROVIDER=""
EMAIL_FROM="suppIT.me <kontakt@suppit.me>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""

# ── Powiadomienia WhatsApp ──
# WHATSAPP_PROVIDER: meta (domyślnie, Meta Cloud API) | twilio
WHATSAPP_PROVIDER="meta"
META_WA_PHONE_NUMBER_ID=""
META_WA_ACCESS_TOKEN=""
# Zatwierdzony szablon w Meta (parametry: {{1}} klient, {{2}} nr zlecenia, {{3}} status, {{4}} uwagi).
# Bez szablonu wysyłana jest zwykła wiadomość — Meta dostarczy ją tylko w 24-h oknie rozmowy.
META_WA_TEMPLATE_NAME=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
TWILIO_CONTENT_SID=""
